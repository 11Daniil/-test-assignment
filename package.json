{
  "name": "banki-shop",
  "version": "1.0.0",
  "private": true,
  "description": "Тестовое задание: адаптивная витрина интернет-магазина на Vue 2",
  "packageManager": "npm@8.19.4",
  "scripts": {
    "dev": "webpack serve --mode development",
    "build": "webpack --mode production",
    "lint": "eslint --ext .js,.vue src tests webpack.config.js babel.config.js jest.config.cjs",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "validate": "npm run lint && npm run format:check && npm test -- --runInBand && npm run build"
  },
  "engines": {
    "node": ">=16",
    "npm": ">=8"
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "not dead"
  ],
  "dependencies": {
    "@fontsource/merriweather": "4.5.14",
    "vue": "2.7.16"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/eslint-parser": "7.24.7",
    "@babel/preset-env": "7.24.7",
    "@vue/test-utils": "1.3.6",
    "@vue/vue2-jest": "29.2.6",
    "babel-loader": "9.1.3",
    "babel-jest": "29.7.0",
    "css-loader": "6.11.0",
    "eslint": "8.57.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-vue": "9.27.0",
    "html-webpack-plugin": "5.6.0",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "mini-css-extract-plugin": "2.9.0",
    "prettier": "2.8.8",
    "style-loader": "3.3.4",
    "vue-loader": "15.11.1",
    "vue-template-compiler": "2.7.16",
    "webpack": "5.109.2",
    "webpack-cli": "5.1.4",
    "webpack-dev-server": "4.15.2"
  },
  "overrides": {
    "node-releases": "2.0.19",
    "@vue/component-compiler-utils": {
      "postcss": "8.5.23"
    },
    "sockjs": {
      "uuid": "11.1.1"
    }
  }
}
